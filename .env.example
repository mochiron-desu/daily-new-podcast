# ==============================================================================
# Daily News Podcast Pipeline — Environment Configuration
# Copy to .env locally, or set as Railway Service Variables.
# ==============================================================================

# --- Node & Failover Topology ---
# Use "primary" on Railway and "fallback" on local machines (Linux / Windows)
NODE_ROLE=fallback
# Unique identifier for this machine (defaults to hostname if blank)
NODE_ID=
# Lower number = higher priority when multiple local machines are online
NODE_PRIORITY=10
# Shared secret protecting /api/* endpoints across Railway and local peers
API_TOKEN=change-me-to-a-long-random-secret

# HTTP server bind settings (Railway automatically injects PORT)
HOST=0.0.0.0
PORT=8787
# Optional public base URL (used if PUBLISHER_BACKEND=local_rss)
PUBLIC_BASE_URL=http://localhost:8787

# Failover discovery URLs
# On local fallback machines, set PRIMARY_URL to your Railway deployment URL:
PRIMARY_URL=
# Comma-separated base URLs of peer nodes (e.g. Tailscale/LAN http://100.x.x.x:8787)
PEER_URLS=

# --- Storage & Schedule Overrides ---
# On Railway, mount a Volume at /app/storage and set STORAGE_DIR=/app/storage
STORAGE_DIR=./storage
TIMEZONE=Asia/Kolkata
PRIMARY_RUN_TIME=06:00
FAILOVER_CUTOFF_MINUTES=20

# --- Google NotebookLM Authentication ---
# Local machines: run `notebooklm login` once (uses ~/.notebooklm/profiles/default/storage_state.json).
# Railway: paste minified storage_state.json in NOTEBOOKLM_AUTH_JSON OR base64 in NOTEBOOKLM_AUTH_B64.
# If STORAGE_DIR is persistent, NOTEBOOKLM_STORAGE_PATH allows cookie refresh writes.
NOTEBOOKLM_PROFILE=default
NOTEBOOKLM_STORAGE_PATH=
NOTEBOOKLM_AUTH_JSON=
NOTEBOOKLM_AUTH_B64=

# --- Publisher Backend ---
# "podbean" (recommended: external RSS + audio) or "local_rss" (self-hosted feed.xml)
PUBLISHER_BACKEND=podbean

# Podbean REST API (https://developers.podbean.com/)
PODBEAN_CLIENT_ID=
PODBEAN_CLIENT_SECRET=
PODBEAN_PUBLISH_STATUS=publish
PODBEAN_EPISODE_TYPE=public

# --- Telegram Stage Notifications & Artifact Delivery ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Send audio and PDF dossier to Telegram after publishing (default: true)
TELEGRAM_SEND_ARTIFACTS=true

# --- Storage Retention ---
# Automatically clean up generated audio/dossier/prompt files after publishing to save volume space (default: true)
STORAGE_CLEANUP_AFTER_PUBLISH=true

# --- Optional Binary Overrides ---
FFMPEG_BIN=

